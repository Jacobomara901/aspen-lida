# Specific locations within Aspen LiDA to exclude from git   #
# Files are excluded either because                               #
#  - they contain sensitive data (i.e. passwords)                 #
#  - they can change at runtime                                   #
#  - they can be easily downloaded or are machine specfic         #
###################################################################
node_modules/
package-lock.json
code/.expo/**
code/.expo-shared/**
code/node_modules/**
.vscode

# IDE Files #
#################
.buildpath
.project
.classpath
org.eclipse.*.prefs
*.css.map
.settings/
out/
.idea/**

# OS generated files #
######################
.DS_Store*
ehthumbs.db
Icon?
Thumbs.db
~$*.docx
~$*.doc
documentation/~*.tmp
# Word Tempory File
.vagrant/

**/app-configs/
.env*
builds/
code/credentials.json
code/%ProgramData%/Microsoft/Windows/UUS/State/_active.uusver
