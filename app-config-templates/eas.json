{
  "cli": {
	"version": "16.32.0"
  },
  "build": {
	"production": {
	  "yarn": "1.22.19",
	  "distribution": "store",
	  "channel": "production",
	  "environment": "production",
	  "env": {
		"APP_ENV": "{{APP_ENV}}",
		"GOOGLE_SERVICES_JSON": "./google-services.json"
	  },
	  "android": {
		"resourceClass": "medium"
	  },
	  "ios": {
		"image": "latest",
		"resourceClass": "medium"
	  }
	},
	"beta": {
	  "extends": "production",
	  "channel": "beta",
	  "environment": "preview",
	  "android": {
		"resourceClass": "medium"
	  },
	  "ios": {
		"resourceClass": "medium"
	  }
	},
	"alpha": {
	  "extends": "production",
	  "distribution": "internal",
	  "channel": "alpha",
	  "environment": "preview",
	  "ios": {
		"simulator": true,
		"resourceClass": "medium"
	  },
	  "android": {
		"buildType": "apk",
		"resourceClass": "medium"
	  }
	},
	"development": {
	  "extends": "production",
	  "channel": "development",
	  "environment": "development",
	  "developmentClient": true,
	  "distribution": "internal",
	  "ios": {
		"simulator": true,
		"resourceClass": "medium"
	  }
	},
	"internal": {
	  "extends": "production",
	  "channel": "internal"
	}
  },
  "submit": {
	"production": {
	  "android": {
		"track": "production",
		"releaseStatus": "draft",
		"serviceAccountKeyPath": "{{DEV_GOOGLE_SERVICE_KEY_PATH}}"
	  },
	  "ios": {
		"ascApiKeyPath": "{{DEV_APPLE_API_KEY_PATH}}",
		"ascApiKeyIssuerId": "{{DEV_APPLE_API_KEY_ISSUER_ID}}",
		"ascApiKeyId": "{{DEV_APPLE_API_KEY_ID}}",
		"appleId": "{{DEV_APPLE_ID}}",
		"ascAppId": "{{DEV_APP_ID}}",
		"appleTeamId": "{{DEV_TEAM_ID}}"
	  }
	},
	"beta": {
	  "extends": "production",
	  "android": {
		"track": "beta"
	  }
	},
	"internal": {
	  "extends": "production",
	  "android": {
		"track": "internal",
		"releaseStatus": "draft"
	  }
	}
  }
}
